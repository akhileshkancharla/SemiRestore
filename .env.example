# Copy to .env and adjust only for the local machine. Do not commit .env.
SEMIRESTORE_CHECKPOINT_HOST_PATH=./artifacts/model/semirestore_conditioned.pt
SEMIRESTORE_API_PORT=8000
SEMIRESTORE_DASHBOARD_PORT=5173
SEMIRESTORE_PROMETHEUS_PORT=9090
SEMIRESTORE_DASHBOARD_API_BASE_URL=/service
SEMIRESTORE_ENVIRONMENT=development
SEMIRESTORE_LOG_LEVEL=INFO
SEMIRESTORE_JSON_LOGGING=true
SEMIRESTORE_DEVICE_PREFERENCE=cpu
SEMIRESTORE_INFERENCE_CONCURRENCY_LIMIT=1
SEMIRESTORE_CONCURRENCY_ACQUISITION_TIMEOUT_SECONDS=1.0
SEMIRESTORE_INFERENCE_TIMEOUT_SECONDS=120.0
SEMIRESTORE_API_CPUS=2.0
SEMIRESTORE_API_MEMORY=4g
SEMIRESTORE_DASHBOARD_CPUS=0.5
SEMIRESTORE_DASHBOARD_MEMORY=128m
SEMIRESTORE_PROMETHEUS_CPUS=0.5
SEMIRESTORE_PROMETHEUS_MEMORY=256m
SEMIRESTORE_PROMETHEUS_RETENTION=24h
